<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gps.gpsproject.controladores.MapaControlador"
            style="-fx-background-color: #F0F0F5;">
    <children>

        <HBox spacing="10"
              AnchorPane.topAnchor="12"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              alignment="CENTER_LEFT">
            <children>

                <ComboBox fx:id="cbOrigen"
                          promptText="Origen"
                          prefWidth="170"/>

                <ComboBox fx:id="cbDestino"
                          promptText="Destino"
                          prefWidth="170"/>

                <ComboBox fx:id="cbFiltro"
                          prefWidth="130"/>

                <ComboBox fx:id="cbAlgoritmo"
                          prefWidth="150"/>

                <Button fx:id="btnBuscar"
                        text="🔍 Buscar Ruta"
                        onAction="#buscarRuta"
                        prefWidth="140"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Button fx:id="btnRutaAlternativa"
                        text="🔀 Ruta Alternativa"
                        onAction="#buscarRutaAlternativa"
                        prefWidth="160"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <Separator orientation="VERTICAL" prefHeight="30"/>

                <Button fx:id="btnReload"
                        text="🔀 Redistribuir"
                        onAction="#redistribuirLayout"
                        prefWidth="140"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

                <CheckBox fx:id="chkArrastre"
                          text="Arrastre"
                          selected="true"
                          onAction="#toggleArrastre"
                          style="-fx-font-size: 13px;"/>

            </children>
        </HBox>

        <AnchorPane fx:id="panelGrafo"
                    style="-fx-background-color: #F0F0F5;"
                    AnchorPane.topAnchor="55"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.bottomAnchor="90"/>

        <Pane fx:id="overlayArrastre"
              style="-fx-background-color: transparent;"
              AnchorPane.topAnchor="55"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="90"
              visible="false"
              mouseTransparent="false"/>

        <HBox fx:id="panelResultados"
              spacing="20"
              alignment="CENTER_LEFT"
              AnchorPane.bottomAnchor="8"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              style="-fx-background-color: white; -fx-border-color: #dcdcdc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15 10 15;">
            <children>

                <VBox spacing="2">
                    <Label text="Ruta" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblRuta" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="2">
                    <Label text="Tiempo" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblTiempo" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="2">
                    <Label text="Distancia" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblDistancia" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="2">
                    <Label text="Costo" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblCosto" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="2">
                    <Label text="Transbordos" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblTransbordo" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="2">
                    <Label text="Algoritmo" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblAlgoritmo" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="2">
                    <Label text="Red conexa" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblConexo" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

            </children>
        </HBox>

    </children>
</AnchorPane>