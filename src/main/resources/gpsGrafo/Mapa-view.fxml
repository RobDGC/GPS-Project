<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gps.gpsproject.controladores.MapaControlador"
            style="-fx-background-color: #F0F0F5;">
    <children>

        <HBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              alignment="CENTER_LEFT">
            <children>

                <Label text="Origen:">
                    <font><Font name="Arial Bold" size="14.0"/></font>
                </Label>
                <ComboBox fx:id="cbOrigen" prefWidth="160"/>

                <Label text="Destino:">
                    <font><Font name="Arial Bold" size="14.0"/></font>
                </Label>
                <ComboBox fx:id="cbDestino" prefWidth="160"/>

                <Label text="Filtro:">
                    <font><Font name="Arial Bold" size="14.0"/></font>
                </Label>
                <ComboBox fx:id="cbFiltro" prefWidth="140"/>

                <Button fx:id="btnBuscar"
                        text="🔍 Buscar Ruta"
                        onAction="#buscarRuta"
                        prefWidth="150"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>

            </children>
        </HBox>


        <AnchorPane fx:id="panelGrafo"
                    style="-fx-background-color: #F0F0F5;"
                    AnchorPane.topAnchor="65"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.bottomAnchor="110"/>

        <HBox fx:id="panelResultados"
              spacing="30"
              alignment="CENTER_LEFT"
              AnchorPane.bottomAnchor="10"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              style="-fx-background-color: white; -fx-border-color: #dcdcdc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 20 12 20;">
            <children>

                <!-- Ruta -->
                <VBox spacing="3">
                    <Label text="Ruta" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblRuta"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Tiempo -->
                <VBox spacing="3">
                    <Label text="Tiempo" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblTiempo"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Distancia -->
                <VBox spacing="3">
                    <Label text="Distancia" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblDistancia"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Costo -->
                <VBox spacing="3">
                    <Label text="Costo" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblCosto"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Transbordos -->
                <VBox spacing="3">
                    <Label text="Transbordos" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblTransbordo"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Conexo -->
                <VBox spacing="3">
                    <Label text="Red conexa" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    <Label fx:id="lblConexo"
                           text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

            </children>
        </HBox>

    </children>
</AnchorPane>
