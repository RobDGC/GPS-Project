<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="420.0"
            style="-fx-background-color: #F0F0F5;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gps.gpsproject.controladores.RutaFormularioControlador">

    <VBox spacing="16"
          AnchorPane.topAnchor="30"
          AnchorPane.bottomAnchor="30"
          AnchorPane.leftAnchor="30"
          AnchorPane.rightAnchor="30">

        <Label fx:id="lblTitulo" text="Nueva Ruta">
            <font><Font name="Arial Bold" size="24.0"/></font>
        </Label>

        <VBox spacing="5">
            <Label text="Origen:">
                <font><Font name="Arial Bold" size="13.0"/></font>
            </Label>
            <ComboBox fx:id="cbOrigen" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Destino:">
                <font><Font name="Arial Bold" size="13.0"/></font>
            </Label>
            <ComboBox fx:id="cbDestino" maxWidth="Infinity"/>
        </VBox>

        <HBox spacing="16">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Tiempo (min):">
                    <font><Font name="Arial Bold" size="13.0"/></font>
                </Label>
                <TextField fx:id="txtTiempo" promptText="Ej: 15"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Distancia (km):">
                    <font><Font name="Arial Bold" size="13.0"/></font>
                </Label>
                <TextField fx:id="txtDistancia" promptText="Ej: 8.5"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Costo ($):">
                    <font><Font name="Arial Bold" size="13.0"/></font>
                </Label>
                <TextField fx:id="txtCosto" promptText="Ej: 25"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Transbordos:">
                    <font><Font name="Arial Bold" size="13.0"/></font>
                </Label>
                <TextField fx:id="txtTransbordo" promptText="Ej: 0"/>
            </VBox>
        </HBox>

        <HBox spacing="12" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="btnGuardar"
                    text="Guardar"
                    onAction="#guardar"
                    prefWidth="180"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
            <Button fx:id="btnCancelar"
                    text="Cancelar"
                    onAction="#cancelar"
                    prefWidth="180"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
        </HBox>

    </VBox>

</AnchorPane>